# Copiar a .env. .env NO se versiona.
# Backend
DB_PUBLICO=data/db/publico.gpkg
TILES_DIR=data/tiles
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_PORT=8000
# Frontend (Vite lee solo variables VITE_*)
VITE_API_URL=http://localhost:8000
VITE_TILES_URL=http://localhost:8000/tiles

# Administración (Fase 5). Poner ADMIN_ENABLED=false en la instancia pública.
ADMIN_ENABLED=true
ADMIN_DB=data/db/admin.sqlite
ADMIN_TOKEN_HORAS=12
ADMIN_SECRET=generar_con_secrets.token_urlsafe(48)

# Contabilidad (Fase 3)
EMPRESA_NOMBRE=
EMPRESA_NIT=
# Facturación electrónica: ninguno (por defecto) | simulado (solo pruebas) | un adaptador propio registrado en backend/app/contable/dian.py
DIAN_PROVEEDOR=ninguno
